ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
CHROMA_PERSIST_DIR=data/chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
TOP_K_FINAL=5
RRF_K=60

# Agent katmani (Gemini free tier) -- RAG API'si icin gerekli degil
GEMINI_API_KEY=your-gemini-key-here
GEMINI_AGENT_MODEL=gemini-2.5-flash

# --- Dagitim (production) ---
# Kalici volume yolu. Railway benzeri platformda /data'ya volume baglanir.
# Yerelde bos birakin: varsayilan data/chroma kullanilir.
# CHROMA_PERSIST_DIR=/data/chroma

# Dokuman yukleme. Korpus ziyaretciler arasinda paylasimli oldugu ve kullanici
# izolasyonu bulunmadigi icin dagitimda KAPALI kalmali.
UPLOAD_ENABLED=false
UPLOAD_MAX_BYTES=10485760

# CORS. Bos birakilirsa middleware hic eklenmez; onerilen dagitimda tarayici
# backend'e dogrudan konusmaz (Next.js sunucu tarafi proxy'ler), bu yuzden bos
# kalmasi normaldir. Tarayicinin dogrudan konusmasi gerekiyorsa yalnizca
# frontend origin'ini yazin, joker (*) kullanmayin.
# ALLOWED_ORIGINS=https://agent-lab.vercel.app
