# ============================================================
# Agent + RAG servisi -- ornek yapilandirma
# GERCEK ANAHTAR YAZMAYIN. Bu dosya repoda tutulur.
# ============================================================

# --- Gemini (tek LLM + embedding saglayicisi) ---
# Hem cevap uretimi hem embedding icin kullanilir.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_AGENT_MODEL=gemini-2.5-flash

# --- Embedding ---
# Embedding Gemini API uzerinden uretilir; yerel ML modeli yuklenmez.
# Deger bir Gemini embedding modeli olmali (HuggingFace adi DEGIL).
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Retrieval ---
CHROMA_PERSIST_DIR=data/chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
TOP_K_FINAL=5
RRF_K=60

# --- Ingest (operator ucu) ---
# /ingest varsayilan olarak KAPALIDIR: token tanimlanmadikca 503 doner.
# Guclu, rastgele bir deger uretin (orn. `openssl rand -hex 32`).
INGEST_API_TOKEN=

# --- Upload (web kullanicilari) ---
# Korpus tum ziyaretciler arasinda paylasimli, kullanici izolasyonu yok:
# dagitimda KAPALI kalmali.
UPLOAD_ENABLED=false
UPLOAD_MAX_BYTES=10485760

# --- CORS ---
# Bos birakilirsa middleware hic eklenmez. Onerilen dagitimda tarayici
# backend'e dogrudan konusmaz (Next.js sunucu tarafi proxy'ler), bu yuzden
# bos kalmasi normaldir. Joker (*) kullanmayin.
# ALLOWED_ORIGINS=https://ornek.vercel.app

# --- LEGACY (production'da gerekmez) ---
# Eski /query ucu ve Streamlit arayuzu icin. `anthropic` paketi uretim
# bagimliligi degildir (`uv sync --extra legacy` ile kurulur). Bos
# birakilabilir; production path (web -> /agent/ask) Anthropic kullanmaz.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
