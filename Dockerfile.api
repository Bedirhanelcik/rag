# Agent + RAG servisi. Render/Railway benzeri bir platformda veya
# docker-compose ile calisir. Sirlar imaja girmez: her sey ortam degiskeniyle
# verilir, .env .dockerignore tarafindan dislanir.
FROM python:3.11-slim

WORKDIR /app

# Yerel bir ML modeli yuklenmiyor: embedding Gemini API uzerinden uretiliyor.
# Bu sayede imajda model onbellegi tutulmuyor ve surec bellegi 512 MB'lik
# ortamlarda bile dusuk kaliyor (olculen acilis: ~148 MB).
ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY src ./src

# --no-dev: test ve degerlendirme bagimliliklari (promptevals dahil) uretim
# imajina girmez.
RUN uv sync --frozen --no-dev

# Kalici dizin: platformda buraya bir volume baglanir ve CHROMA_PERSIST_DIR
# bunu gosterir (orn. CHROMA_PERSIST_DIR=/data/chroma). Volume baglanmazsa da
# dizin var oldugu icin uygulama acilabilir.
RUN mkdir -p /data/chroma
VOLUME ["/data"]

EXPOSE 8000

# Platform PORT'u ortam degiskeniyle verir; yoksa 8000.
# Shell formu kasitli: ${PORT} genislemesi icin gerekli.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request; \
urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8000')}/health\").read()"

CMD uvicorn rag_tr.api.main:app --host 0.0.0.0 --port ${PORT:-8000}
